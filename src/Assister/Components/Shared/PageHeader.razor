<div class="page-header">
    <div><p class="eyebrow">@Eyebrow</p><h1>@Title</h1>@if (!string.IsNullOrEmpty(Description)) { <p class="page-description">@Description</p> }</div>
    @if (Actions is not null) { <div class="page-actions">@Actions</div> }
</div>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Eyebrow { get; set; } = "OVERVIEW";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
