@page "/"
@page "/index.html"
@implements IAsyncDisposable
@inject BrowserApi Api
<PageTitle>Overview · Assister</PageTitle>
<h1 class="visually-hidden">Overview</h1>
<Notice Message="@notice" Error="@error" />
<Notice Message="@refreshError" Error="true" />
<section class="health-grid" aria-label="Component health">
    @foreach(var c in health.Prop("components").Items()){
        <details class="card health-card"><summary><strong>@c.Text("name")</strong><span class="status-pill @(c.Text("status").Equals("Healthy",StringComparison.OrdinalIgnoreCase)?"good":"")">@c.Text("status")</span></summary>
        <p class="muted">@c.Text("detail")</p>
        @if(c.Text("name")=="Home Assistant"){<button disabled="@loading" @onclick="Rebuild">Rebuild cache</button>}
        </details>
    }
</section>
<div class="dashboard-toolbar">
    <div class="tabs" role="group" aria-label="Diagnostic panels">
        <button aria-pressed="@(panel=="explorer")" @onclick="@(() => panel = "explorer")">Run explorer</button>
        <button aria-pressed="@(panel=="debug")" @onclick="@(() => panel = "debug")">Debug chat</button>
    </div>
    <div class="row">
        <button disabled="@loading" @onclick="Refresh">Refresh</button>
        <span class="status-pill">@connection</span>
    </div>
</div>
@if(panel=="explorer"){
    <div class="split run-workspace">
        <section class="card">
            <h2>Recent interactions</h2>
            <div class="stack">
                <label>Search <input placeholder="Request, response or ID" @bind="search" @bind:event="oninput" /></label>
                <div class="form-grid">
                    <label>Source <select @bind="source"><option value="">All sources</option>@foreach(var value in Values("source",source)){<option>@value</option>}</select></label>
                    <label>Outcome <select @bind="outcome"><option value="">All outcomes</option>@foreach(var value in Values("outcome",outcome)){<option>@value</option>}</select></label>
                </div>
                <div class="tabs">@foreach(var q in new[]{"All","Failures","LLM","Direct","Voice","Debug"}){<button aria-pressed="@(quick==q)" @onclick="()=>quick=q">@q</button>}</div>
                <small>@Filtered.Length of @runs.Length interactions · refresh every 3 seconds</small>
                <div class="scroll-region run-list" tabindex="0" role="region" aria-label="Recent interactions list">
                @foreach(var run in Filtered){
                    <button class="list-button @(run.Text("runId")==selectedId?"selected":"")" aria-pressed="@(run.Text("runId")==selectedId)" @key="@(run.Text("runId"))" @onclick="@(() => SelectRun(run.Text("runId")))">
                        <strong>@run.Text("userText","Waiting for transcript…")</strong>
                        <div class="subtle">@run.Text("source") · @Api.Date(run,"startedAt") · @run.Number("durationMilliseconds").ToString("F0") ms</div>
                        <span class="status-pill @(run.Text("outcome")=="succeeded"?"good":run.Flag("hasFailures")?"bad":"")">@run.Text("outcome")</span>
                    </button>
                }
                @if(Filtered.Length==0){<p class="empty">No matching interactions.</p>}
                </div>
            </div>
        </section>
        <section class="card run-detail">
            @if(selectedRun.ValueKind!=JsonValueKind.Object){<div class="empty">@(runNotice??"Select an interaction to inspect the pipeline.")</div>}
            else{
                <div class="row"><h2>Run details</h2><span class="status-pill">@selectedRun.Text("outcome")</span></div>
                <p>@selectedRun.Text("userText")</p>
                <RunTimeline Run="@selectedRun" />
                <div class="grid run-facts">
                    @foreach(var field in new[]{("Source",selectedRun.Text("source")),("Handled by",selectedRun.Text("handledBy")),("Duration",selectedRun.Number("durationMilliseconds").ToString("F0")+" ms"),("Satellite",selectedRun.Text("satelliteId")),("Run ID",selectedRun.Text("runId"))}){
                        <div class="panel"><small>@field.Item1</small><div class="mono">@field.Item2</div></div>
                    }
                </div>
                <h3>Assistant response</h3><p>@selectedRun.Text("rawResponse")</p>
                @if(selectedRun.Text("spokenResponse")!=selectedRun.Text("rawResponse")){<details><summary>Spoken output</summary><p>@selectedRun.Text("spokenResponse")</p></details>}
                <details class="panel"><summary>Complete stage log</summary>
                @foreach(var step in selectedRun.Prop("steps").Items().OrderBy(x=>x.Number("sequence"))){
                    <details class="panel" @key="@(step.Text("id"))"><summary><span class="status-pill @(step.Text("status")=="failed"?"bad":"")">@step.Text("status")</span> @step.Text("name") · @step.Text("kind") · @step.Number("durationMilliseconds").ToString("F0") ms</summary><p>@step.Text("summary")</p><JsonDetails Title="Input" Data="@step.Prop("input")" /><JsonDetails Title="Output" Data="@step.Prop("output")" /><JsonDetails Title="Stage metadata" Data="@step.Prop("metadata")" /></details>
                }
                </details>
                <JsonDetails Title="Full run record" Data="@selectedRun" />
            }
        </section>
    </div>
}else{
    <div class="split run-workspace">
        <section class="card stack"><h2>Debug session</h2><p class="muted">This uses the real request coordinator and can execute device commands. No microphone or audio output.</p>
            <label>Area <input @bind="area" placeholder="office" /></label>
            <label>Synthetic satellite ID <input @bind="satellite" maxlength="128" /></label>
            <p class="mono">@((conversation??"New conversation"))</p>
            <button @onclick="NewConversation" disabled="@sending">New conversation</button>
        </section>
        <section class="card stack"><h2>Messages</h2>
            <div aria-live="polite" class="scroll-region debug-messages" tabindex="0" role="region" aria-label="Debug messages">
                @foreach(var m in messages){<article class="panel"><strong>@m.Role</strong><p>@m.Content</p>@if(m.RunId is not null){<button @onclick="()=>InspectFromDebug(m.RunId)">Inspect run</button>}</article>}
                @if(messages.Count==0){<p class="empty">Send a request to exercise the assistant.</p>}
            </div>
            <label>Message <textarea rows="3" maxlength="1000" @bind="message" placeholder="Ask Assister…"></textarea></label>
            <button class="primary" disabled="@sending" @onclick="Send">@(sending?"Processing…":"Send request")</button>
        </section>
    </div>
}
@code {
    [Parameter][SupplyParameterFromQuery(Name="run")] public string? RunQuery {get;set;}
    record MessageRow(string Role,string Content,string? RunId=null);
    JsonElement[] runs=[];JsonElement health,selectedRun;
    string? selectedId,conversation,runNotice,refreshError;
    string panel="explorer",connection="Connecting",notice="",search="",source="",outcome="",quick="All",area="",satellite="debug-ui",message="";
    bool loading,error,sending,loadRouteSelection,newConversation=true;List<MessageRow> messages=new();
    CancellationTokenSource poll=new();
    long selectionVersion;
    IEnumerable<string> Values(string field,string selected)=>runs.Select(r=>r.Text(field)).Append(selected).Where(v=>v.Length>0).Distinct().Order();
    JsonElement[] Filtered=>runs.Where(r=>(string.IsNullOrWhiteSpace(search)||
        r.Text("userText").Contains(search,StringComparison.OrdinalIgnoreCase)||r.Text("rawResponse").Contains(search,StringComparison.OrdinalIgnoreCase)||
        r.Text("runId").Contains(search,StringComparison.OrdinalIgnoreCase))&&
        (source==""||r.Text("source")==source)&&(outcome==""||r.Text("outcome")==outcome)&&
        (quick=="All"||quick=="Voice"&&r.Text("source")=="voice"||quick=="Debug"&&r.Text("source")=="debug"||
        quick=="LLM"&&r.Text("handledBy")=="language-model"||quick=="Direct"&&r.Text("handledBy")=="direct-intent"||
        quick=="Failures"&&(r.Flag("hasFailures")||!new[]{"succeeded","running","no-speech"}.Contains(r.Text("outcome"))))).ToArray();
    protected override void OnParametersSet()
    {
        if(RunQuery is not { Length:>0 } || RunQuery==selectedId)return;
        SetSelection(RunQuery);
        panel="explorer";
        loadRouteSelection=true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender){
        if(firstRender){
            loadRouteSelection=false;
            try { satellite=(await Api.Storage("assister-debug-satellite"))??"debug-ui";conversation=await Api.Storage("assister-debug-conversation"); }
            catch(JSException){ }
            newConversation=string.IsNullOrEmpty(conversation);
            await Refresh();
            if(!poll.IsCancellationRequested){StateHasChanged();_ = Poll(poll.Token);}
        }
        else if(loadRouteSelection){
            loadRouteSelection=false;await LoadSelected();if(!poll.IsCancellationRequested)StateHasChanged();
        }
    }
    async Task Poll(CancellationToken token){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(3));while(await timer.WaitForNextTickAsync(token)){await InvokeAsync(async()=>{await Refresh();StateHasChanged();});}}catch(OperationCanceledException){}}
    async Task Refresh(){if(loading)return;loading=true;try{
        var runRequest=Api.Get("/api/diagnostics/runs").AsTask();
        var healthRequest=Api.Get("/api/diagnostics/health").AsTask();
        await Task.WhenAll(runRequest,healthRequest);
        runs=runRequest.Result.Items().ToArray();health=healthRequest.Result;
        connection="Live · "+Api.Clock.Now.ToString("T");
        if(string.IsNullOrEmpty(selectedId) && runs.Length>0)SetSelection(runs[0].Text("runId"));
        if(panel=="explorer")await LoadSelected();
        refreshError=null;
    }catch(Exception ex){connection="Offline";refreshError=ex.Message;}finally{loading=false;}}
    void SetSelection(string id)
    {
        selectedId=id;selectedRun=default;runNotice="Loading interaction…";selectionVersion++;
    }
    async Task LoadSelected()
    {
        if(selectedId is not { Length:>0 } id || (selectedRun.Text("runId")==id && selectedRun.Text("finishedAt").Length>0
            && runs.Any(r=>r.Text("runId")==id)))return;
        var version=++selectionVersion;
        try
        {
            var run=await Api.Get("/api/diagnostics/runs/"+Uri.EscapeDataString(id));
            if(version==selectionVersion){selectedRun=run;runNotice=null;}
        }
        catch(BrowserApiException ex) when(ex.StatusCode==404)
        {
            if(version==selectionVersion){selectedRun=default;runNotice="This interaction is no longer in the retained history.";}
        }
        catch(Exception ex){if(version==selectionVersion)runNotice=ex.Message;}
    }
    async Task SelectRun(string id){SetSelection(id);await LoadSelected();}
    async Task Rebuild(){try{await Api.Post("/api/homeassistant/cache/rebuild");notice="Home Assistant cache rebuilt.";error=false;await Refresh();}catch(Exception ex){notice=ex.Message;error=true;}}
    async Task NewConversation(){conversation=null;messages.Clear();newConversation=true;await Api.SetStorage("assister-debug-conversation",null);}
    async Task Send(){if(string.IsNullOrWhiteSpace(message)||sending)return;sending=true;var prompt=message.Trim();messages.Add(new("You",prompt));message="";
        try{var r=await Api.Post("/api/test/message",new{message=prompt,satelliteId=satellite,area=string.IsNullOrWhiteSpace(area)?null:area,conversationId=conversation,newConversation});
            conversation=r.Text("conversationId");newConversation=false;
            await Api.SetStorage("assister-debug-conversation",conversation);await Api.SetStorage("assister-debug-satellite",satellite);
            messages.Add(new("Assister",r.Text("response")+"\n"+r.Text("outcome"),r.Text("runId")));await Refresh();notice="";error=false;
        }catch(Exception ex){notice=ex.Message;error=true;}finally{sending=false;}}
    async Task InspectFromDebug(string? id){if(string.IsNullOrEmpty(id))return;panel="explorer";await SelectRun(id);}
    public ValueTask DisposeAsync(){poll.Cancel();poll.Dispose();return ValueTask.CompletedTask;}
}
