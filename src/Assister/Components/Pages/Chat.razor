@page "/chat"
@page "/chat.html"
@implements IAsyncDisposable
@inject BrowserApi Api
@inject IJSRuntime JS
<PageTitle>Conversation · Assister</PageTitle>
<PageHeader Title="Conversation">
    <Actions><span class="status-pill @(connected?"good":"")">@connection</span></Actions>
</PageHeader>
<Notice Message="@notice" Error="@error" />
@if(!connected){
    <form class="card stack chat-login" @onsubmit="Login" @onsubmit:preventDefault>
        <h2>Connect a client</h2><p class="muted">Use a configured rich-client credential. The API manages an eight-hour session cookie.</p>
        <label>Bearer credential <input type="password" autocomplete="off" @bind="credential" /></label>
        <button class="primary" type="submit" disabled="@busy">Connect</button>
    </form>
}else{
    <div class="toolbar">
        <label>Conversation <select disabled="@(busy||recording)" @bind="conversationId" @bind:after="Open">
            @foreach(var c in conversations){<option value="@c.Text("id")">@c.Text("title","Conversation")</option>}
        </select></label>
        <button disabled="@(busy||recording)" @onclick="NewConversation">New conversation</button>
        <button disabled="@busy" @onclick="Logout">Sign out</button>
    </div>
    <div class="split chat-workspace">
        <section class="card stack">
            <div aria-live="polite" class="stack scroll-region chat-history" tabindex="0" role="region" aria-label="Conversation history">
                @if(interactions.Length==0){<p class="empty">Start a conversation by sending a message.</p>}
                @foreach(var item in interactions){
                    var id=item.Text("id");
                    <article class="panel" @key="id">
                        <div class="row"><strong>YOU</strong><small>@Api.Date(item,"createdAt")</small></div>
                        <p>@item.Text("input")</p><h3>ASSISTER</h3>
                        <p style="white-space:pre-wrap">@ResponseFor(item)</p>
                        <span class="status-pill @(item.Text("status")=="completed"?"good":item.Text("status")=="failed"?"bad":"")">@item.Text("status")</span>
                        @if(audioReady.Contains(id)){
                            <div><audio data-interaction="@id" controls preload="none" src="@("/api/client/interactions/"+id+"/audio")"></audio></div>
                        }
                        <details><summary>Execution activity</summary>
                            @foreach(var ev in EventsFor(id).Where(x=>x.Text("type").StartsWith("step.")||x.Text("type").StartsWith("interaction.")||x.Text("type").StartsWith("tts."))){
                                <p class="subtle">@ev.Text("type") · @ev.Prop("data").Text("label") @ev.Prop("data").Text("status")</p>
                            }
                        </details>
                        <details><summary>Context and trace</summary>
                            <button @onclick="()=>LoadContext(id)">Load context and trace</button>
                            @if(context.TryGetValue(id,out var data)){<JsonDetails Title="Context used" Data="@data" />}
                            @if(traces.TryGetValue(id,out var trace)){<JsonDetails Title="Diagnostic trace" Data="@trace" />}
                        </details>
                        @if(attachmentsFor.TryGetValue(id,out var files)){
                            @foreach(var attachment in files.Items()){<a href="@("/api/client/attachments/"+attachment.Text("id"))" download>@attachment.Text("name")</a>}
                        }
                    </article>
                }
            </div>
            <div class="panel stack">
                <label>Ask Assister <textarea @bind="message" rows="3" maxlength="1000" placeholder="How warm is the office?"></textarea></label>
                <label>Attach text files <input type="file" id="chat-attachments" multiple accept=".txt,.md,.json" disabled="@busy" /></label>
                <div class="actions">
                    <button disabled="@busy" @onclick="UploadFiles">Upload selected attachments</button>
                    @foreach(var file in attachments){<span class="status-pill">@file.Text("name") <button class="ghost" disabled="@busy" aria-label="@("Remove "+file.Text("name"))" @onclick="()=>RemoveAttachment(file)">×</button></span>}
                </div>
                <label class="check"><input type="checkbox" @bind="speak" /> Request spoken answers</label>
                <div class="actions">
                    <button disabled="@busy" @onclick="ToggleMic">@(recording?"Stop and send recording":"Record voice")</button>
                    <button @onclick="StopSpeech">Stop speech</button>
                    <button disabled="@(busy||string.IsNullOrEmpty(activeId))" @onclick="Cancel">Cancel current run</button>
                    <button id="chat-send" class="primary" disabled="@(busy||recording)" @onclick="() => Send()">Send</button>
                </div>
                <small class="muted">Requests can execute real device commands. Microphone access requires HTTPS or localhost.</small>
            </div>
        </section>
        <aside class="card"><h2>Live activity</h2>
            @if(string.IsNullOrEmpty(activeId)){<p class="empty">Nothing running.</p>}
            else{
                <p class="mono">@activeId</p>
                @foreach(var ev in EventsFor(activeId).TakeLast(30)){
                    <div class="panel"><small>@ev.Text("type")</small><div>@ev.Prop("data").Text("label",ev.Prop("data").Text("text"))</div></div>
                }
            }
        </aside>
    </div>
}
@code {
    JsonElement[] conversations=[],interactions=[];List<JsonElement> attachments=new();
    Dictionary<string,List<JsonElement>> eventMap=new();Dictionary<string,long> cursors=new();
    Dictionary<string,JsonElement> context=new(),traces=new(),attachmentsFor=new();HashSet<string> audioReady=new();
    string conversationId="",credential="",message="",connection="Connecting…",notice="";string? activeId;
    bool connected,busy,error,speak,recording,rendered,refreshing,pollError;
    CancellationTokenSource polling=new(); DateTimeOffset lastRegistration;
    string ResponseFor(JsonElement item){var value=item.Text("response");if(!string.IsNullOrEmpty(value))return value;
        if(eventMap.TryGetValue(item.Text("id"),out var events)){
            var done=events.LastOrDefault(x=>x.Text("type")=="response.completed");
            if(done.ValueKind==JsonValueKind.Object)return done.Prop("data").Text("text");
            var partial=string.Concat(events.Where(x=>x.Text("type")=="response.delta").Select(x=>x.Prop("data").Text("text")));
            if(partial.Length>0)return partial;
            var failed=events.LastOrDefault(x=>x.Text("type")=="interaction.failed");
            if(failed.ValueKind==JsonValueKind.Object)return failed.Prop("data").Text("message","Request failed.");
        }
        return item.Text("status") switch { "failed" => "Request failed.", "cancelled" => "Request cancelled.", "completed" => "No response.", _ => "Working…" };
    }
    IEnumerable<JsonElement> EventsFor(string id)=>eventMap.TryGetValue(id,out var events)?events:Enumerable.Empty<JsonElement>();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)return;
        rendered=true;
        busy=true;
        StateHasChanged();
        try { await Load(); }
        catch(BrowserApiException ex) when(ex.StatusCode==401) { connection="Authentication required"; }
        catch(Exception ex) { connection="Disconnected";notice=ex.Message;error=true; }
        finally { busy=false; }
        if(!polling.IsCancellationRequested){ StateHasChanged();_ = Poll(polling.Token); }
    }
    async Task Login(){if(busy)return;busy=true;try{
        if(!string.IsNullOrWhiteSpace(credential))await Api.Post("/api/client/session",new{token=credential.Trim()});
        credential="";await Load();notice="";error=false;pollError=false;
    }catch(Exception ex){notice=ex.Message;error=true;}finally{busy=false;}}
    async Task Register(){ await Api.Post("/api/client/clients/register",new{clientType="web",deviceName="Blazor web client",capabilities=new[]{"text.input","text.output","attachments.file","attachments.image","audio.input","audio.output","audio.output.segments","execution.steps","context.inspect","events.replay"}}); lastRegistration=DateTimeOffset.UtcNow; }
    async Task Load(){
        await Api.Get("/api/client/protocol");
        await Register();
        conversations=(await Api.Get("/api/client/conversations")).Items().ToArray();
        if(conversations.Length==0){await Api.Post("/api/client/conversations");conversations=(await Api.Get("/api/client/conversations")).Items().ToArray();}
        var saved=await Api.Storage("assister-conversation");conversationId=conversations.FirstOrDefault(x=>x.Text("id")==saved).ValueKind==JsonValueKind.Object?saved!:conversations.First().Text("id");
        await OpenConversation();
        connected=true;connection="Connected";
    }
    async Task Open()
    {
        busy=true;
        try { await OpenConversation(); }
        catch(Exception ex) { notice=ex.Message;error=true; }
        finally { busy=false; }
    }
    async Task OpenConversation()
    {
        await JS.InvokeVoidAsync("assisterSpeech.stop");
        eventMap.Clear();cursors.Clear();audioReady.Clear();context.Clear();traces.Clear();attachmentsFor.Clear();
        interactions=[];activeId=null;
        await RefreshConversation();
        await Api.SetStorage("assister-conversation",conversationId);
    }
    async Task NewConversation(){if(busy)return;busy=true;try{
        var c=await Api.Post("/api/client/conversations");conversationId=c.Text("id");
        conversations=(await Api.Get("/api/client/conversations")).Items().ToArray();await OpenConversation();
    }catch(Exception ex){notice=ex.Message;error=true;}finally{busy=false;}}
    async Task Logout()
    {
        busy=true;
        try
        {
            await JS.InvokeVoidAsync("assisterSpeech.stop");
            await JS.InvokeVoidAsync("assisterApi.voiceCancel");
            recording=false;
            await Api.Delete("/api/client/clients/current");
            await Api.Delete("/api/client/session");
            ClearSession();
            notice="";error=false;
        }
        catch(BrowserApiException ex) when(ex.StatusCode==401){ ClearSession(); }
        catch(Exception ex){notice=ex.Message;error=true;}
        finally{busy=false;}
    }
    void ClearSession()
    {
        connected=false;connection="Authentication required";conversationId="";interactions=[];attachments.Clear();eventMap.Clear();
        message="";activeId=null;pending=null;
    }
    async Task UploadFiles(){if(busy)return;busy=true;try{
        var files=await JS.InvokeAsync<JsonElement[]>("assisterApi.uploadAttachments","chat-attachments",8-attachments.Count);
        attachments.AddRange(files);notice="Attachments ready.";error=false;
    }catch(Exception ex){notice=ex.Message;error=true;}finally{busy=false;}}
    async Task RemoveAttachment(JsonElement item){if(busy)return;busy=true;try{await Api.Delete("/api/client/attachments/"+item.Text("id"));attachments.Remove(item);}catch(Exception ex){notice=ex.Message;error=true;}finally{busy=false;}}
    async Task ToggleMic(){if(busy)return;busy=true;try{
        if(!recording){await JS.InvokeVoidAsync("assisterApi.voiceStart");recording=true;connection="Recording";}
        else{var id=await JS.InvokeAsync<string>("assisterApi.voiceStop");recording=false;connection="Connected";await Submit("Voice input",id);}
    }catch(Exception ex){recording=false;connection="Connected";notice=ex.Message;error=true;}finally{busy=false;}}
    (string Conversation, string Message, string Attachments, string? Audio, bool Speak, bool StreamSpeech)? pending;
    string? pendingKey;
    async Task Send(){if(busy||recording||string.IsNullOrWhiteSpace(message)||string.IsNullOrEmpty(conversationId))return;busy=true;
        try { await Submit(message.Trim()); }
        catch(Exception ex){notice=ex.Message;error=true;}finally{busy=false;}
    }
    async Task Submit(string sent,string? audioId=null)
    {
        var spoken=speak;
        var streamSpeech=spoken && await JS.InvokeAsync<bool>("assisterSpeech.prepare");
        var ids=attachments.Select(x=>x.Text("id")).ToArray();
        var submission=(conversationId,sent,string.Join(',',ids),audioId,spoken,streamSpeech);
        if(pending!=submission){pending=submission;pendingKey=Guid.NewGuid().ToString();}
        var item=await Api.Post("/api/client/conversations/"+Uri.EscapeDataString(conversationId)+"/interactions",
            new{message=sent,idempotencyKey=pendingKey,attachmentIds=ids,audioAttachmentId=audioId,speak=spoken,streamSpeech});
        pending=null;
        if(audioId is null && message.Trim()==sent)message="";
        attachments.Clear();activeId=item.Text("id");
        if(spoken)await JS.InvokeVoidAsync("assisterSpeech.start",activeId);
        notice="";error=false;
    }
    async Task RefreshConversation()
    {
        var selected=conversationId;
        if(string.IsNullOrEmpty(selected))return;
        var history=(await Api.Get("/api/client/conversations/"+Uri.EscapeDataString(selected))).Items().ToArray();
        if(conversationId!=selected)return;
        interactions=history;
        activeId=history.LastOrDefault(x=>x.Text("status") is not ("completed" or "failed" or "cancelled")).Text("id");
        foreach(var item in history)
        {
            var id=item.Text("id");
            if(cursors.GetValueOrDefault(id)<item.Number("lastSequence"))await LoadEvents(selected,id);
            if(conversationId!=selected)return;
        }
    }
    async Task LoadEvents(string selected,string id){
        var cursor=cursors.GetValueOrDefault(id);
        for(var i=0;i<8;i++){
            var page=(await Api.Get("/api/client/interactions/"+Uri.EscapeDataString(id)+"/events?afterSequence="+cursor)).Items().ToArray();
            if(conversationId!=selected)return;
            cursor=cursors.GetValueOrDefault(id);
            if(!eventMap.ContainsKey(id))eventMap[id]=new();
            foreach(var ev in page){var seq=(long)ev.Number("sequence");if(seq<=cursor)continue;
                cursor=seq;eventMap[id].Add(ev);if(ev.Text("type")=="tts.audio")audioReady.Add(id);
            }
            cursors[id]=cursor;if(page.Length<256)break;
        }
    }
    async Task LoadContext(string id){try{context[id]=await Api.Get("/api/client/interactions/"+id+"/context");
        attachmentsFor[id]=await Api.Get("/api/client/interactions/"+id+"/attachments");
        try{traces[id]=await Api.Get("/api/client/interactions/"+id+"/trace");}
        catch(BrowserApiException ex) when(ex.StatusCode==404){traces.Remove(id);}
        }catch(Exception ex){notice=ex.Message;error=true;}}
    async Task StopSpeech()=>await JS.InvokeVoidAsync("assisterSpeech.stop");
    async Task Cancel(){if(activeId is null)return;try{await JS.InvokeVoidAsync("assisterSpeech.stop");await Api.Post("/api/client/interactions/"+activeId+"/cancel");notice="Cancellation requested.";}catch(Exception ex){notice=ex.Message;error=true;}}
    async Task Poll(CancellationToken token){try{using var timer=new PeriodicTimer(TimeSpan.FromSeconds(1));while(await timer.WaitForNextTickAsync(token)){
        await InvokeAsync(async()=>{
            if(!connected||busy||refreshing)return;
            refreshing=true;
            try{
                if(DateTimeOffset.UtcNow-lastRegistration>=TimeSpan.FromSeconds(30))await Register();
                await RefreshConversation();
                connection=recording?"Recording":"Connected";
                if(pollError){notice="";error=false;pollError=false;}
            }
            catch(BrowserApiException ex) when(ex.StatusCode==401){ ClearSession();notice="Your session expired. Connect again.";error=true; }
            catch(Exception ex){connection="Retrying…";notice=ex.Message;error=true;pollError=true;}
            finally{refreshing=false;}
            if(!token.IsCancellationRequested)StateHasChanged();
        });
    }}catch(OperationCanceledException){}}
    public async ValueTask DisposeAsync(){polling.Cancel();polling.Dispose();if(rendered)try{await JS.InvokeVoidAsync("assisterSpeech.stop");}catch(JSDisconnectedException){}if(recording){try{await JS.InvokeVoidAsync("assisterApi.voiceCancel");}catch{}}}
}
