{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SpeechToText": {
    "OverlapEnabled": false
  },
  "Voice": {
    "StreamingEnabled": true
  },
  "RichClients": {
    "RetentionDays": 30,
    "MaxInteractions": 10000,
    "AudioRetentionHours": 24,
    "MaxAttachmentMiB": 100
  },
  "Diagnostics": {
    "CaptureAudio": true,
    "AudioRetentionHours": 24,
    "MaxAudioMiB": 256
  }
}
